FROM node:24.13.0-alpine3.23@sha256:cd6fb7efa6490f039f3471a189214d5f548c11df1ff9e5b181aa49e22c14383e

ARG OMNIAGENT_RELEASE_SHA
ENV NODE_ENV=production
ENV OMNIAGENT_RELEASE_SHA=$OMNIAGENT_RELEASE_SHA
WORKDIR /app

COPY --chown=node:node scripts/worker.mjs ./worker.mjs

USER node
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=150s --retries=3 \
  CMD ["node", "-e", "require('node:fs').readFile('/tmp/omniagent-worker-heartbeat','utf8',(error,data)=>{let healthy=false;try{const lanes=JSON.parse(data);const now=Date.now();const max=Number(process.env.OMNIAGENT_WORKER_HEARTBEAT_MAX_AGE_MS||2100000);const inFlightMax=Number(process.env.OMNIAGENT_WORKER_REQUEST_TIMEOUT_MS||300000)+60000;healthy=['fast','background','maintenance'].every((lane)=>{const state=lanes[lane]||{};return state.inFlight?Number.isFinite(state.startedAt)&&now-state.startedAt<=inFlightMax:Number.isFinite(state.lastSuccessAt)&&now-state.lastSuccessAt<=max&&(!state.lastFailureAt||state.lastSuccessAt>=state.lastFailureAt)})}catch{}process.exit(!error&&healthy?0:1)})"]

CMD ["node", "worker.mjs"]

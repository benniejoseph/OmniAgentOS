{
  "name": "asael",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "smoke:security": "node scripts/smoke-security.mjs",
    "smoke:tenant": "node scripts/smoke-tenant-isolation.mjs",
    "smoke:eval": "node scripts/smoke-eval-case.mjs",
    "smoke:release": "node scripts/smoke-release-evidence.mjs",
    "smoke:preflight": "node scripts/smoke-preflight.mjs",
    "test:security": "npm run smoke:security",
    "test:tenant": "npm run smoke:tenant",
    "test:production-smoke": "npm run smoke:preflight && npm run smoke:security && npm run smoke:tenant && npm run smoke:eval && npm run smoke:release",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "NODE_ENV=test VERCEL= VERCEL_ENV= vitest run",
    "test:coverage": "NODE_ENV=test VERCEL= VERCEL_ENV= vitest run --coverage",
    "test:integration": "NODE_ENV=test VERCEL= VERCEL_ENV= vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "benchmark:preview": "node scripts/benchmark-preview.mjs",
    "benchmark:dashboard": "node scripts/benchmark-dashboard.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "check:worker": "node --check scripts/worker.mjs && node --check scripts/openai-egress-gateway.mjs",
    "check:operations": "node --check scripts/db-backup.mjs && node --check scripts/db-restore-drill.mjs && node --check scripts/benchmark-preview.mjs && node --check scripts/benchmark-dashboard.mjs && node --check scripts/smoke-preflight.mjs && node --check scripts/smoke-security.mjs && node --check scripts/smoke-eval-case.mjs",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore-drill": "node scripts/db-restore-drill.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:integration && npm run check:worker && npm run check:operations && npm run build && npm run audit:production",
    "eval:agents": "node scripts/run-evals.mjs",
    "worker": "node scripts/worker.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "mammoth": "^1.12.1",
    "next": "16.3.1",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.12",
    "undici": "^8.10.0",
    "web-vitals": "^6.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}

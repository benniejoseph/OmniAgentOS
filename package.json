{
  "name": "asael",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "smoke:security": "node scripts/smoke-security.mjs",
    "smoke:tenant": "node scripts/smoke-tenant-isolation.mjs",
    "smoke:eval": "node scripts/smoke-eval-case.mjs",
    "smoke:release": "node scripts/smoke-release-evidence.mjs",
    "smoke:preflight": "node scripts/smoke-preflight.mjs",
    "smoke:paid-agent": "node scripts/smoke-paid-agent.mjs",
    "test:security": "npm run smoke:security",
    "test:tenant": "npm run smoke:tenant",
    "test:production-smoke": "npm run smoke:preflight && npm run smoke:security && npm run smoke:tenant && npm run smoke:eval && npm run smoke:release",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "NODE_ENV=test VERCEL= VERCEL_ENV= vitest run",
    "test:coverage": "NODE_ENV=test VERCEL= VERCEL_ENV= vitest run --coverage",
    "test:integration": "NODE_ENV=test VERCEL= VERCEL_ENV= vitest run --config vitest.integration.config.ts",
    "benchmark:preview": "node scripts/benchmark-preview.mjs",
    "benchmark:dashboard": "node scripts/benchmark-dashboard.mjs",
    "check:p05-baseline": "tsx --conditions=react-server scripts/check-p05-baseline.ts",
    "check:p43-query-planning": "tsx --tsconfig tsconfig.scripts.json scripts/check-p43-query-planning.ts",
    "check:p44-multilingual-retrieval": "tsx --tsconfig tsconfig.scripts.json scripts/check-p44-multilingual-retrieval.ts",
    "check:p45-context-budget": "tsx --tsconfig tsconfig.scripts.json scripts/check-p45-context-budget.ts",
    "check:p52-entity-resolution": "tsx scripts/check-p52-entity-resolution.ts",
    "check:p62-semantic-routing": "tsx --tsconfig tsconfig.scripts.json scripts/check-p62-semantic-routing.ts",
    "check:semantic-memory-shadow": "tsx --tsconfig tsconfig.scripts.json scripts/check-semantic-memory-shadow.ts",
    "audit:production": "node scripts/npm-audit-production.mjs",
    "check:worker": "node --check scripts/worker.mjs && node --check scripts/openai-egress-gateway.mjs",
    "check:operations": "node --check scripts/db-backup.mjs && node --check scripts/db-restore-drill.mjs && node --check scripts/benchmark-preview.mjs && node --check scripts/benchmark-dashboard.mjs && node --check scripts/resolve-production-smoke-revision.mjs && node --check scripts/smoke-preflight.mjs && node --check scripts/smoke-security.mjs && node --check scripts/smoke-eval-case.mjs && node --check scripts/smoke-paid-agent.mjs",
    "generate:native-contracts": "tsx scripts/generate-native-contracts.ts",
    "check:native-contracts": "tsx scripts/generate-native-contracts.ts --check",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore-drill": "node scripts/db-restore-drill.mjs",
    "sync:tradingview": "node scripts/sync-tradingview-library.mjs",
    "predeploy:production": "npm run sync:tradingview",
    "deploy:production": "node scripts/deploy-production.mjs",
    "verify": "npm run audit:production && npm run typecheck && npm run lint && npm run test:coverage && npm run test:integration && npm run check:worker && npm run check:operations && NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100 npm run build",
    "eval:agents": "node scripts/run-evals.mjs",
    "worker": "node scripts/worker.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/sandbox": "^3.3.0",
    "ajv": "^8.20.0",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "mammoth": "^1.12.1",
    "next": "16.3.5",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "three": "^0.186.0",
    "tsx": "^4.23.12",
    "undici": "^8.10.0",
    "web-vitals": "^6.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "3.2.7"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "postcss": "^8.5.23",
    "qs": "6.16.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.2.0": true
  }
}

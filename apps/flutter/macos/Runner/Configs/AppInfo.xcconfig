// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// Compatibility product name: keep the existing bundle/executable upgrade path.
// CFBundleDisplayName exposes the Asael brand to users.
PRODUCT_NAME = omniagent

// Compatibility bundle identifier: changing it would break installed upgrades.
PRODUCT_BUNDLE_IDENTIFIER = app.omniagent.omniagent

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Asael. All rights reserved.

FROM mcr.microsoft.com/playwright/mcp:v0.0.80@sha256:dda1f7f9b812e22946635c8af7df9288b96d3b9e3f0f1b8576d6823e2031c1de

ARG OMNIAGENT_RELEASE_SHA
ENV NODE_ENV=production
ENV OMNIAGENT_RELEASE_SHA=$OMNIAGENT_RELEASE_SHA

COPY --chown=node:node infra/playwright-mcp/gateway.mjs /app/omniagent-playwright-gateway.mjs
COPY --chown=node:node infra/playwright-mcp/playwright-mcp.config.json /app/playwright-mcp.config.json

USER node
EXPOSE 8080
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8080/healthz').then((response)=>process.exit(response.ok?0:1)).catch(()=>process.exit(1))"]

ENTRYPOINT ["node", "/app/omniagent-playwright-gateway.mjs"]

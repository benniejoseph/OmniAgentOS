# Local/demo defaults. Production still enforces authentication and durable storage.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.1
OMNIAGENT_REQUEST_TIMING_SAMPLE_RATE=0.05
OMNIAGENT_ALLOWED_READ_AUDIT_SAMPLE_RATE=0.05
OMNIAGENT_AUTH_ENABLED=false
OMNIAGENT_ALLOW_DEMO_STORAGE=false
OMNIAGENT_LOCAL_PRODUCTION=false
OMNIAGENT_DEFAULT_TENANT=default
OMNIAGENT_TIME_ZONE=UTC
OMNIAGENT_DEFAULT_ACTOR=anonymous
OMNIAGENT_DEFAULT_ROLE=viewer
OMNIAGENT_DATA_DIR=
OMNIAGENT_TRUST_UNSIGNED_IDENTITY_HEADERS=false
OMNIAGENT_TRUST_PROXY_HEADERS=false
OMNIAGENT_CONNECTOR_ALLOW_HTTP=false
OMNIAGENT_CONNECTOR_ALLOW_LEGACY_SYSTEM_SECRETS=false

# Production-required values. Set secrets in the deployment secret manager.
OPENAI_API_KEY=
# Required when Vercel runs in sin1. Keep the OpenAI API key on Vercel; the
# existing Fly worker provides the US egress proxy without a second service.
OMNIAGENT_OPENAI_GATEWAY_URL=https://omniagent-os-worker.fly.dev/v1
# Generate one independent URL-safe 32-256 character secret and store the same
# value in Vercel and Fly secret managers. Vercel sensitive values cannot be
# pulled back; inject this from the owner's password manager for release runs.
# Never commit or log it.
OMNIAGENT_OPENAI_GATEWAY_TOKEN=
# Fly-only, rotation-window fallback. Never set this on Vercel.
OMNIAGENT_OPENAI_GATEWAY_PREVIOUS_TOKEN=
# Bounds the secret-free /healthz evidence probe from the Vercel runtime.
OMNIAGENT_OPENAI_GATEWAY_HEALTH_TIMEOUT_MS=5000
DATABASE_URL=
# Per-process runtime and maintenance pool size. Durable production runtimes
# default to 4; local/test runtimes default to 1. Values are capped at 20.
# Vercel enforces 1 per runtime or maintenance pool in each route bundle and
# disables postgres.js's idle and maximum-lifetime timers so a frozen isolate
# cannot thaw into a concurrent timer-close and pool-reservation race. A timed-
# out Vercel reservation retires only that exact one-slot pool so the next
# request starts with a fresh client.
OMNIAGENT_DATABASE_POOL_MAX=4
# Bounds how long a tenant- or system-scoped query/callback transaction waits
# to reserve a postgres.js pool slot. Clamped to 0.5-30s; defaults to 20s so a
# cold US-to-Singapore pooled connection can complete within the route ceiling.
OMNIAGENT_DATABASE_ACQUIRE_TIMEOUT_MS=20000
# Cancels every tenant- and system-scoped runtime statement after 1-60s. The
# default is 15s; route-specific aggregate reads may lower it transactionally.
OMNIAGENT_DATABASE_STATEMENT_TIMEOUT_MS=15000
# Fails lock acquisition after 0.1-10s and never exceeds the statement timeout.
OMNIAGENT_DATABASE_LOCK_TIMEOUT_MS=1000
# Closes a runtime transaction left idle between statements after 1-60s. This
# is transaction-local, defaults to 15s, and releases abandoned pool leases.
OMNIAGENT_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
# Bounds the production migration-marker verification query. A timed-out
# verification is reset so the next request can retry instead of sharing a
# permanently pending schema promise.
OMNIAGENT_SCHEMA_VERIFICATION_TIMEOUT_MS=10000
# Maximum time the private Settings capability read waits for its single
# tenant-scoped storage snapshot before returning explicit unavailable fields.
OMNIAGENT_SETTINGS_CAPABILITY_TIMEOUT_MS=1250
# Cancels the underlying aggregate query so a timed-out HTTP read cannot hold a
# pool slot indefinitely. This is intentionally longer than the response bound.
OMNIAGENT_SETTINGS_CAPABILITY_STATEMENT_TIMEOUT_MS=5000
# Cancels the owner-scoped Today aggregate if database execution stalls. The
# value is clamped between 1s and 15s; the default is 5s.
OMNIAGENT_TODAY_SNAPSHOT_STATEMENT_TIMEOUT_MS=5000
# Dedicated non-owner, non-superuser BYPASSRLS role for audited system-scope
# operations. It must point to the same database as DATABASE_URL.
OMNIAGENT_MAINTENANCE_DATABASE_URL=
# Dedicated release jobs run DDL with a migration-owner connection.
MIGRATION_DATABASE_URL=
OMNIAGENT_MIGRATION_STATEMENT_TIMEOUT_MS=600000
MIGRATION_DATABASE_ROLE=
# Used only by db:backup; configure a dedicated BYPASSRLS role.
OMNIAGENT_BACKUP_DATABASE_URL=
CRON_SECRET=
OMNIAGENT_RELEASE_SHA=
OMNIAGENT_INTERNAL_AUTH_SECRET=
# Dedicated 32+ byte key for sealing approval-gated tool inputs at rest.
# Falls back to OMNIAGENT_INTERNAL_AUTH_SECRET with domain-separated key derivation.
OMNIAGENT_EXECUTION_PAYLOAD_SECRET=
OMNIAGENT_BOOTSTRAP_EMAIL=
OMNIAGENT_BOOTSTRAP_PASSWORD=
OMNIAGENT_OWNER_EMAIL=
OMNIAGENT_BOOTSTRAP_NAME=Asael Owner
OMNIAGENT_BOOTSTRAP_TENANT=Asael
OMNIAGENT_REPORT_SIGNING_SECRET=
# Bound expensive password verification work per application process.
OMNIAGENT_PASSWORD_VERIFY_CONCURRENCY=4
OMNIAGENT_PASSWORD_VERIFY_QUEUE_LIMIT=64
# Serialized heavy worker lanes can legitimately wait behind two bounded jobs.
OMNIAGENT_WORKER_HEARTBEAT_MAX_AGE_MS=2100000
# The production release runner sets this to true only on its candidate Fly
# image, then activates the exact canonical revision after every release gate.
# Local workers and rollback images remain unheld.
OMNIAGENT_WORKER_RELEASE_HOLD=false
OMNIAGENT_REPORT_SIGNING_KEY_ID=omniagent-report-signing-secret
OMNIAGENT_REPORT_SIGNING_KEYS=
OMNIAGENT_ACCESS_REQUEST_FILE=

# Models, retrieval, and bounded execution.
OPENAI_AGENT_MODEL=gpt-5
OPENAI_REASONING_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-4o-mini
# Optional per-million-token prices. Telemetry always records tokens; USD cost is
# emitted only for models explicitly listed here so stale prices are never guessed.
OPENAI_MODEL_PRICING_JSON={"gpt-5":{"input":1.25,"cachedInput":0.125,"output":10},"gpt-4o-mini":{"input":0.15,"cachedInput":0.075,"output":0.6}}
OPENAI_WEB_SEARCH_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_OCR_MODEL=gpt-4o-mini
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional per-million-token rates for Gemini telemetry; unset rates never guess cost.
GEMINI_MODEL_PRICING_JSON={"gemini-3.5-flash-lite":{"input":0.3,"cachedInput":0.03,"output":2.5}}
ANTHROPIC_MODEL_PRICING_JSON={}

# Personal read-only Gmail, Calendar, and Drive OAuth. Register the callback URL as:
# ${NEXT_PUBLIC_APP_URL}/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional Google AI/media providers. Keep these server-side. The Gemini key
# should be restricted to generativelanguage.googleapis.com; the media key to
# Speech-to-Text, Text-to-Speech, and Vision APIs.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_REASONING_MODEL=claude-sonnet-5
# Ordered, capability-aware provider preference. Unconfigured providers are skipped.
OMNIAGENT_MODEL_PROVIDER_ORDER=openai,google,anthropic
GOOGLE_MEDIA_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=asael-private-ai
GOOGLE_CLOUD_LOCATION=us-central1
OPENAI_EMBEDDING_DIMENSIONS=1536
OMNIAGENT_WEB_SEARCH_TIMEOUT_MS=25000
OMNIAGENT_WORKFLOW_PLANNER_TIMEOUT_MS=45000
OMNIAGENT_WORKFLOW_EXECUTOR_TIMEOUT_MS=10000
OMNIAGENT_WORKFLOW_PLAN_MAX_TOOL_CALLS=24
OMNIAGENT_WORKFLOW_PLAN_MAX_COST_UNITS=64
OMNIAGENT_WORKFLOW_PLAN_MAX_WALL_CLOCK_MS=60000
OMNIAGENT_WORKFLOW_PLAN_NODES_PER_TICK=3
OMNIAGENT_AGENT_MAX_TOOL_STEPS=6
OMNIAGENT_AGENT_MAX_MESSAGE_CHARS=32000
OMNIAGENT_AGENT_MAX_MESSAGES=40
OMNIAGENT_AGENT_RUNS_PER_MINUTE=10
OMNIAGENT_AGENT_REASONING_EFFORT=minimal
OMNIAGENT_AGENT_MAX_OUTPUT_TOKENS=2000

# Storage, queues, auth, and trust.
OMNIAGENT_QUEUE_LEASE_SECONDS=120
OMNIAGENT_WORKFLOW_DRAIN_LIMIT=2
OMNIAGENT_ALERT_QUEUE_LIMIT=10
OMNIAGENT_ALERT_DISPATCH_LIMIT=10
OMNIAGENT_SESSION_DAYS=7
OMNIAGENT_LOG_PGVECTOR_FAILURES=false
OMNIAGENT_GRADUATED_AUTONOMY=false
OMNIAGENT_AUTONOMY_GRADUATION_THRESHOLD=25
OMNIAGENT_RETENTION_PENDING_APPROVAL_DAYS=7
OMNIAGENT_RETENTION_PENDING_ACCESS_DAYS=30
OMNIAGENT_RETENTION_REVIEWED_ACCESS_DAYS=365
OMNIAGENT_RETENTION_EPISODE_MEMORY_DAYS=30
OMNIAGENT_RETENTION_CONSOLIDATED_MEMORY_DAYS=365
OMNIAGENT_RETENTION_RETRIEVAL_TRACE_DAYS=30
OMNIAGENT_RETENTION_WORKFLOW_DAYS=90
OMNIAGENT_RETENTION_TRIGGER_EVENT_DAYS=90
OMNIAGENT_RETENTION_OPERATION_JOB_DAYS=90
OMNIAGENT_RETENTION_RUN_DAYS=30
OMNIAGENT_RETENTION_TOOL_DAYS=90
OMNIAGENT_RETENTION_EVENT_DAYS=90
OMNIAGENT_RETENTION_OBSERVABILITY_DAYS=30
OMNIAGENT_RETENTION_HEALTH_DAYS=30
OMNIAGENT_RETENTION_EVALUATION_DAYS=90
OMNIAGENT_RETENTION_GRAPH_BUILD_DAYS=30
OMNIAGENT_RETENTION_SECURITY_DAYS=365
# Maximum rows removed per data class in one retention transaction (100-5000).
OMNIAGENT_RETENTION_BATCH_SIZE=500

# Connector secret references and outbound alert delivery.
OMNIAGENT_CONNECTOR_SECRET_ALLOWLIST=
OMNIAGENT_CONNECTOR_SECRET_BINDINGS=
OMNIAGENT_CONNECTOR_EXAMPLE_MCP_BEARER_TOKEN=
OMNIAGENT_CONNECTOR_EXAMPLE_OPENAPI_BEARER_TOKEN=
OMNIAGENT_CONNECTOR_EXAMPLE_OPENAPI_API_KEY=
# Incoming webhook HMAC keys use OMNIAGENT_TRIGGER_* names. Legacy names must
# be explicitly allowlisted in production.
OMNIAGENT_TRIGGER_SECRET_ALLOWLIST=
OMNIAGENT_TRIGGER_EXAMPLE_GITHUB_SECRET=
OMNIAGENT_TRIGGER_EVALUATION_SECRET=
OMNIAGENT_ALERT_WEBHOOK_URL=
OMNIAGENT_ALERT_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
OMNIAGENT_ALERT_EMAIL_TO=
OMNIAGENT_ALERT_EMAIL_FROM=

# Dedicated worker. OMNIAGENT_INTERNAL_AUTH_SECRET is shared through secret storage.
OMNIAGENT_WORKER_BASE_URL=http://localhost:3000
OMNIAGENT_WORKER_PROTOCOL_VERSION=1
OMNIAGENT_WORKER_INTERVAL_MS=5000
OMNIAGENT_WORKER_BACKGROUND_INTERVAL_MS=15000
OMNIAGENT_WORKER_BACKGROUND_STARTUP_DELAY_MS=7500
OMNIAGENT_WORKER_MAINTENANCE_INTERVAL_MS=300000
OMNIAGENT_WORKER_MAINTENANCE_STARTUP_DELAY_MS=60000
OMNIAGENT_WORKER_MAINTENANCE_FIRST_RUN_DELAY_MS=900000
OMNIAGENT_WORKER_REQUEST_TIMEOUT_MS=300000
OMNIAGENT_WORKER_LIMIT=3
OMNIAGENT_WORKER_SLO=true
OMNIAGENT_WORKER_ALERTS=true
OMNIAGENT_WORKER_RETENTION=true
OMNIAGENT_WORKER_RETENTION_INTERVAL_MS=21600000
OMNIAGENT_WORKER_RETENTION_STARTUP_DELAY_MS=600000

# Production smoke runner. Keep these out of the web application environment.
BASE_URL=
OMNIAGENT_DEPLOY_WORKER_STARTUP_SETTLE_MS=75000
OMNIAGENT_DEPLOY_GATEWAY_READINESS_TIMEOUT_MS=120000
OMNIAGENT_DEPLOY_GATEWAY_READINESS_POLL_MS=1000
OMNIAGENT_DEPLOY_GATEWAY_READINESS_REQUEST_TIMEOUT_MS=5000
OMNIAGENT_DEPLOY_PAID_INFERENCE_TIMEOUT_MS=60000
OMNIAGENT_DEPLOY_OPENAI_SMOKE_MODEL=gpt-4o-mini
# One-time only when introducing the Fly gateway to a pre-gateway release.
# Unset after the first successful paired rollout.
OMNIAGENT_OPENAI_GATEWAY_INITIAL_CUTOVER=
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
SMOKE_INTERNAL_AUTH_SECRET=
SMOKE_TENANT_ID=production_smoke
SMOKE_ACTOR_ID=production-smoke
SMOKE_EVAL_CASE_ID=security.tenant_isolation
SMOKE_SYNTHETIC_SOURCE=production-smoke
SMOKE_RUN_ID=
SMOKE_REQUEST_TIMEOUT_MS=15000
EXPECT_SECURE_COOKIES=true
RELEASE_EVIDENCE_OUTPUT=artifacts/release-evidence.json
RELEASE_EVIDENCE_MAX_BYTES=262144

# Live agent evaluation runner.
MIN_PASS_RATE=0.6
EVAL_REQUEST_TIMEOUT_MS=60000
